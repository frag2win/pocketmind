        android:pathData="M30,35 L55,35 C62,35 62,45 55,45 L30,45 L30,75 M45,45 L45,75 M45,45 L58,58 L71,45 L71,75"
        android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="35"
                android:endX="71"
                android:endY="75"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.5" android:color="#FFB0B0B0" />
                <item android:offset="1" android:color="#FF808080" />
            </gradient>
        </aapt:attr>
    </path>
